// Meridian — Prisma schema
//
// Provider: Postgres. DATABASE_URL is provided by the host (Railway, Neon,
// Supabase, etc.). For purely local exploration you can swap `provider` to
// "sqlite" and set DATABASE_URL to "file:./dev.db" — the model definitions
// are provider-agnostic. Run `npx prisma migrate deploy` after the swap.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Source {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  url         String
  rssUrl      String?
  region      String
  category    String
  description String
  embedding   Bytes
  articles    Article[]
  createdAt   DateTime  @default(now())
}

model Topic {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String
  parentId    Int?
  parent      Topic?   @relation("TopicHierarchy", fields: [parentId], references: [id])
  children    Topic[]  @relation("TopicHierarchy")
  embedding   Bytes
  createdAt   DateTime @default(now())
}

model Article {
  id          Int      @id @default(autoincrement())
  sourceId    Int
  source      Source   @relation(fields: [sourceId], references: [id])
  title       String
  url         String   @unique
  content     String
  publishedAt DateTime
  embedding   Bytes?
  createdAt   DateTime @default(now())

  @@index([sourceId, publishedAt])
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  emailVerified DateTime?
  filter        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      UserSession[]
  dailyBriefs   DailyBrief[]
}

// One row per (user, calendar-day). Written by the cron job that fans out
// the filter text through the same pipeline My World uses. Read by the
// My World UI's "Today's Brief" panel.
model DailyBrief {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  filterText String
  summary    String
  createdAt  DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model PendingUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  otpHash      String
  otpExpiresAt DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
}

model UserSession {
  id        String      @id
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  queries   UserQuery[]

  @@index([userId])
}

model UserQuery {
  id                Int          @id @default(autoincrement())
  sessionId         String
  session           UserSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rawText           String
  interpretedIntent String
  summaryId         Int?
  summary           UserSummary? @relation(fields: [summaryId], references: [id])
  createdAt         DateTime     @default(now())

  @@index([sessionId, createdAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model UserSummary {
  id          Int         @id @default(autoincrement())
  queryHash   String      @unique
  summaryText String
  mode        String
  length      String
  articleIds  String
  createdAt   DateTime    @default(now())
  queries     UserQuery[]
}

// One row per real (non-stub) DeepSeek call. Drives per-user rate limiting
// and the global daily USD ceiling enforced in lib/deepseek/rate-limit.ts.
// `userId` is null for system-initiated calls (cron, /briefing page cache).
model LlmCall {
  id           Int      @id @default(autoincrement())
  userId       String?
  endpoint     String
  worstCaseUsd Float
  createdAt    DateTime @default(now())

  @@index([endpoint, createdAt])
  @@index([userId, endpoint, createdAt])
  @@index([createdAt])
}
